; Engine configuration file.
; MyKartWorld starts with a lightweight, offline-first shell.

config_version=5

[application]

config/name="MyKartWorld"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/min_width=800
window/size/min_height=480
window/stretch/mode="canvas_items"

[input]

accelerate={
"deadzone": 0.2,
"events": [
Object(InputEventKey, "physical_keycode": 87),
Object(InputEventJoypadMotion, "axis": 5, "axis_value": 1.0)
]
}
brake={
"deadzone": 0.2,
"events": [
Object(InputEventKey, "physical_keycode": 83),
Object(InputEventJoypadMotion, "axis": 4, "axis_value": 1.0)
]
}
steer_left={
"deadzone": 0.2,
"events": [
Object(InputEventKey, "physical_keycode": 65),
Object(InputEventJoypadMotion, "axis": 0, "axis_value": -1.0),
Object(InputEventJoypadButton, "button_index": 13)
]
}
steer_right={
"deadzone": 0.2,
"events": [
Object(InputEventKey, "physical_keycode": 68),
Object(InputEventJoypadMotion, "axis": 0, "axis_value": 1.0),
Object(InputEventJoypadButton, "button_index": 14)
]
}
drift={
"deadzone": 0.2,
"events": [
Object(InputEventKey, "physical_keycode": 32),
Object(InputEventJoypadButton, "button_index": 10)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.07, 0.12, 1)
